      "post": {
        "summary": "Create User",
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "name": "Joey"
              }
            }
          }
        }
      },
      "get": {
        "summary": "Find All Users",
        "responses": {}
      }
    },
