{
  "openapi": "3.0.0",
  "info": {
    "title": "BankApp API",
    "version": "1.0.0",
    "description": "API for the BankApp Java backend. Contains endpoints for managing bank customers.\n\nBase URL is stored in the BankApp environment as {{base_url}}."
  },
  "servers": [
    {
      "url": "{{base_url}}"
    }
  ],
  "paths": {
